   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import os \n",
    "import seaborn as sns\n",
    "\n",
    "folder_path='data/SeoulBike'\n",
    "filelist =os.listdir(folder_path)\n",
    "\n",
    "df=[]\n",
    "for file in filelist:\n",
    "    if file.endswith(\".csv\"):\n",
    "        path=os.path.join('data/SeoulBike/',file)\n",
    "        df.append(pd.read_csv(path))\n",
    "\n",
    "bike = pd.concat(df,ignore_index=True)\n",
    "\n",
    "#인덱스 중복이 생긴다는 것 -> range index가 0~791이 된다는 것.\n",
    "bike[(bike['Rainfall(mm)']!=0) & (bike['Snowfall (cm)']!=0)]\n",
    "\n",
    "#날짜 변환\n",
    "bike['Date']=pd.to_datetime(bike['Date'])\n",
    "pd.to_datetime('12/30/20',format='%m/%d/%y')\n",
    "\n",
    "#week 열 추가\n",
    "bike['Week']=bike['Date'].dt.day_name()\n",
    "\n",
    "#평일 계산기\n",
    "def check_day(row):\n",
    "\n",
    "    condition1=row['Week'] in ['Saturday','Sunday']\n",
    "    condition2=row['Holiday']=='Holiday'\n",
    "    if condition1 or condition2:\n",
    "        return 'Yes'\n",
    "    else:\n",
    "        return 'No'\n",
    "\n",
    "#평일 계산 행 추가\n",
    "bike['Day off']=bike.apply(check_day,axis=1)\n",
    "bike['Day off'].value_counts()/24\n",
    "\n",
    "#feature colum= 종속변수 제외 컬럼들.\n",
    "feature_columns=bike.columns.drop('Rented Bike Count')\n",
    "\n",
    "#상관계수 확인\n",
    "bike.corr(numeric_only=True) \n",
    "\n",
    "\n",
    "\n",
    "\n",
    "#preprocessing\n",
    "# 삭제: 이슬점, 날짜, Functioning day 중 rent=0\n",
    "bike = bike[bike['Rented Bike Count'] >0 ]\n",
    "\n",
    "#종속변수 전처리. -> 수치형 데이터만 남기기?\n",
    "X= bike.drop(['Date','Dew point temperature(C)','Functioning Day','Holiday','Week','Rented Bike Count'],axis=1)\n",
    "y=bike['Rented Bike Count']\n",
    "\n"
   ]
  },
